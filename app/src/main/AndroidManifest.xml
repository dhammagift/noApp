<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Used for two translucent overlays, both optional and gated on this being granted:
         DIRECT mode's "use all shortcut slots" Configure gear (GearOverlayService), and
         MIX mode's draggable collapsed-list bubble (QuickPickPeekOverlayService). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Optional, gated on Settings > "Show recent apps": lets QuickPickSheet show a row of
         recently-used apps (nearest legitimate proxy for a true running-tasks list, which no
         third-party app can read on modern Android) via UsageStatsManager. Only grantable
         through Settings > Usage access, not a runtime permission dialog. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Required to list installed launchable apps for the App-type slot picker on API 30+ package visibility -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".NoAppApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.NoApp">

        <!-- MainActivity is never itself a launcher entry point and its own component is
             NEVER enabled/disabled (see icon/AppIconSwitcher.kt) — GearOverlayService,
             QuickPickActivity, and ShortcutSync all target it by explicit component, and an
             explicit Intent to a disabled component fails to launch. Every launcher icon,
             including the default look, is one of the activity-alias entries below instead.
             Translucent (Theme.NoApp.Main) — see themes.xml for why that's essential. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.NoApp.Main">

            <!-- Sharing API: lets other apps share plain text into Not App -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Translucent popup for the LIST/MIX-mode plain tap and incoming shares — overlays
             whatever was on screen instead of a full opaque app switch. Only ever started
             explicitly (by MainActivity's dispatch or the peek bubble), never a launcher
             target. singleTask so an impatient repeat tap/share reuses the one instance
             (onNewIntent) instead of stacking a second translucent sheet on top of the first —
             dismissing the top one used to reveal a duplicate underneath. -->
        <activity
            android:name=".QuickPickActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.NoApp.Transparent" />

        <!-- Launcher icons (Settings > App icon): one enabled alias at a time, all targeting
             MainActivity, which reads the current mode itself (see icon/AppIconSwitcher.kt).
             The "*List" entries are legacy: older versions enabled those in LIST mode, when
             they targeted QuickPickActivity directly. They stay declared, with the same icon,
             so an install that still has one enabled keeps its launcher icon across the
             update — the code never enables them anymore and disables them on the next icon
             change. Do not remove them without a migration that first enables the main alias. -->
        <activity-alias
            android:name=".IconDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconDefaultList"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconMaterial"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_material"
            android:roundIcon="@mipmap/ic_launcher_material"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
