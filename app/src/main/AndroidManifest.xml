<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only requested/used when Settings > "use all shortcut slots in Direct mode" is on:
         flashes a translucent Configure gear over the app just launched, instead of a
         permanent long-press shortcut. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Required to list installed launchable apps for the App-type slot picker on API 30+ package visibility -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.NoApp">

        <!-- MainActivity is never itself a launcher entry point and its own component is
             NEVER enabled/disabled (see icon/AppIconSwitcher.kt) — GearOverlayService,
             QuickPickActivity, and ShortcutSync all target it by explicit component, and an
             explicit Intent to a disabled component fails to launch. Every launcher icon,
             including the default look, is one of the activity-alias entries below instead. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.NoApp">

            <!-- Sharing API: lets other apps share plain text into Not App -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Translucent popup for the LIST-mode plain tap and incoming shares — overlays
             whatever was on screen instead of a full opaque app switch. In LIST mode it is
             also a direct launcher entry point (see the "*List" aliases below): its own
             starting window is already invisible (windowIsTranslucent + windowDisablePreview
             in Theme.NoApp.Transparent), which is the only way to make a launcher tap in LIST
             mode never flash a splash at all — MainActivity's own theme is opaque, so routing
             a LIST tap through it first (dispatch-then-finish) always flashed its starting
             window first, no matter how briefly. -->
        <activity
            android:name=".QuickPickActivity"
            android:exported="true"
            android:theme="@style/Theme.NoApp.Transparent" />

        <!-- Launcher icons (Settings > App icon). For each variant, exactly one of its two
             aliases below is enabled at a time (see icon/AppIconSwitcher.kt): the "Main" one
             (targeting MainActivity) outside LIST mode, matching DIRECT/MIX's "follow the OS
             theme, show the real starting window" expectation; the "List" one (targeting
             QuickPickActivity, whose theme is already splash-invisible) in LIST mode. Both
             carry the same icon/roundIcon so the launcher/app-drawer entry never changes
             just because the mode did. MainActivity itself stays enabled and is never one of
             these targets' own icon — GearOverlayService, QuickPickActivity's Configure
             button, and ShortcutSync all reach it by explicit component instead. -->
        <activity-alias
            android:name=".IconDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconDefaultList"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:targetActivity=".QuickPickActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconMaterial"
            android:enabled="false"
            android:exported="true"
