        <service
            android:name=".shortcuts.GearOverlayService"
            android:exported="false" />
        <service
            android:name=".shortcuts.QuickPickPeekOverlayService"
            android:exported="false" />

        <!-- Lets Settings > Debug log hand the debug-log file to a share-sheet target (email,
             messaging app, etc.) as a real attachment instead of cramming it into EXTRA_TEXT. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
