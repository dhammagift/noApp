<resources>
    <style name="Theme.NoApp" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>

    <!-- QuickPickActivity: lets whatever was on screen show through behind the sheet
         instead of hard-cutting to a blank app window. -->
    <style name="Theme.NoApp.Transparent" parent="Theme.NoApp">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
