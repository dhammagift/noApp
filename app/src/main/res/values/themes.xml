<resources>
    <style name="Theme.NoApp" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <!-- QuickPickActivity: lets whatever was on screen show through behind the sheet
         instead of hard-cutting to a blank app window. -->
    <style name="Theme.NoApp.Transparent" parent="Theme.NoApp">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <!-- Skip the OS "starting window" preview (splash) for this activity — it's a
             translucent popup, not a real app switch, so a flash-then-list feel is wrong. -->
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- MainActivity: translucent too, and that is load-bearing, not cosmetic. It is the target
         of every launcher tap, and in DIRECT/MIX/LIST it finish()es before drawing anything —
         but on Android 12+ an OPAQUE activity always gets the system splash screen on launch,
         windowDisablePreview or not, which reads as an unwanted flash (and, overlapping the
         real target app's own splash, as a doubled icon). Translucent activities never get a
         starting window at all. Being translucent is also what lets LIST mode route through
         here (instead of needing a second set of launcher aliases targeting QuickPickActivity
         directly, which made switching mode a PackageManager operation — see AppIconSwitcher
         for why that used to close the app). The Compose root paints its own opaque background
         (see MainActivity), so the Config/Settings screens still look like a normal app.
         Keeps the standard activity transition, unlike Transparent, since this one shows real
         screens. -->
    <style name="Theme.NoApp.Main" parent="Theme.NoApp.Transparent">
        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
    </style>
</resources>
